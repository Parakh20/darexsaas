generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────
// TENANT & AUTH
// ─────────────────────────────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  industry    String?
  website     String?
  phone       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  contacts          Contact[]
  opportunities     Opportunity[]
  conversations     Conversation[]
  chatConversations ChatConversation[]
  tasks             Task[]
  auditLogs         AuditLog[]
  workflows         WorkflowRun[]

  @@map("tenants")
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String   @unique
  name      String?
  image     String?
  googleId  String?  @unique
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens     RefreshToken[]
  chatConversations ChatConversation[]
  tasks             Task[]             @relation("TaskAssignee")
  auditLogs         AuditLog[]

  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────
// CRM
// ─────────────────────────────────────────────────

model Contact {
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  company   String?
  position  String?
  status    ContactStatus @default(ACTIVE)
  tags      String[]
  notes     String?
  source    String?
  leadScore Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  conversations Conversation[]
  tasks         Task[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@map("contacts")
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Opportunity {
  id                 String           @id @default(cuid())
  tenantId           String
  contactId          String
  title              String
  value              Float            @default(0)
  currency           String           @default("INR")
  stage              OpportunityStage @default(LEAD)
  probability        Int              @default(10)
  expectedCloseDate  DateTime?
  notes              String?
  aiNextBestAction   String?
  aiNextBestActionAt DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([tenantId])
  @@index([tenantId, stage])
  @@map("opportunities")
}

enum OpportunityStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

// ─────────────────────────────────────────────────
// UNIFIED INBOX (WhatsApp / Email / Call)
// ─────────────────────────────────────────────────

model Conversation {
  id           String     @id @default(cuid())
  tenantId     String
  contactId    String?
  channel      Channel
  externalId   String?
  subject      String?
  status       ConvStatus @default(OPEN)
  aiSummary    String?
  aiIntent     String?
  aiSentiment  Sentiment?
  aiNextAction String?
  aiAnalyzedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([tenantId])
  @@index([tenantId, channel])
  @@index([externalId])
  @@map("conversations")
}

enum Channel {
  WHATSAPP
  EMAIL
  CALL_LOG
}

enum ConvStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  direction      Direction
  body           String
  mediaUrl       String?
  mediaType      String?
  externalId     String?
  senderName     String?
  senderPhone    String?
  status         MsgStatus @default(SENT)
  metadata       Json?
  sentAt         DateTime  @default(now())
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MsgStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// ─────────────────────────────────────────────────
// AI CHATBOT
// ─────────────────────────────────────────────────

model ChatConversation {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  title     String   @default("New Conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([tenantId, userId])
  @@map("chat_conversations")
}

model ChatMessage {
  id                 String   @id @default(cuid())
  chatConversationId String
  role               ChatRole
  content            String
  toolCalls          Json?
  toolResults        Json?
  reasoning          String?
  createdAt          DateTime @default(now())

  chatConversation ChatConversation @relation(fields: [chatConversationId], references: [id], onDelete: Cascade)

  @@index([chatConversationId])
  @@map("chat_messages")
}

enum ChatRole {
  USER
  ASSISTANT
  TOOL
}

// ─────────────────────────────────────────────────
// TASKS
// ─────────────────────────────────────────────────

model Task {
  id            String     @id @default(cuid())
  tenantId      String
  assigneeId    String?
  contactId     String?
  opportunityId String?
  title         String
  description   String?
  dueDate       DateTime?
  status        TaskStatus @default(PENDING)
  priority      Priority   @default(MEDIUM)
  aiGenerated   Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tasks")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  aiInitiated Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, action])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────
// WORKFLOW AUTOMATION
// ─────────────────────────────────────────────────

model WorkflowRun {
  id          String         @id @default(cuid())
  tenantId    String
  workflowKey String
  entityId    String?
  entityType  String?
  status      WorkflowStatus @default(RUNNING)
  steps       Json           @default("[]")
  result      Json?
  error       String?
  startedAt   DateTime       @default(now())
  completedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, workflowKey])
  @@map("workflow_runs")
}

enum WorkflowStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}
